# PADRÃO: portfólio não comercial, com registros fictícios isolados por sessão.
# Sem credenciais e sem banco externo para este modo.
NEXT_PUBLIC_APP_MODE=portfolio
APP_MODE=portfolio
NEXT_TELEMETRY_DISABLED=1
APP_ORIGIN=http://localhost:3000

# PREENCHER SOMENTE EM SERVIDOR DE HOMOLOGAÇÃO CONECTADO, por canal seguro.
# Mudar AMBOS os modos para connected, configurar e refazer o build.
# Em produção APP_ORIGIN deve ser o domínio HTTPS exato, sem caminho.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
BOX_WORKSPACE_ID=

# MFA é obrigatório no código E nas regras do banco, para todas as contas.
# Não há chave de serviço no aplicativo web.
# Formulários públicos reais, redes, WhatsApp, e-mail e pagamentos não são ativados
# com variáveis: exigem integração e validação adicionais. Não há chave mágica.
